{
  "name": "protesis-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Monitor biomecánico en tiempo real para prótesis de pierna instrumentada (ESP32 + FSR + MPU6050)",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "build:esp32": "vite build && node scripts/copy-to-esp32.mjs",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "chart.js": "^4.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-react": "^5.0.0",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.1.11",
    "vite": "^7.1.0"
  }
}
